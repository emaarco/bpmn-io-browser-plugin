{
  "name": "git-diagram-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Browser extension that renders and diffs BPMN files inline on GitLab & GitHub — plus a standalone .bpmn viewer.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/bot",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @git-diagram-viewer/extension",
    "dev:example": "npm run dev:example -w @git-diagram-viewer/extension",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @git-diagram-viewer/extension --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:deps": "npm run lint:deps --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
