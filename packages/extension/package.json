{
  "name": "@bpmn-io-browser-plugin/extension",
  "version": "0.0.0",
  "private": true,
  "description": "BPMN viewer & diff browser extension (Chrome, Edge, Firefox) for GitLab & GitHub.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:example": "WXT_DEV_EXAMPLE=1 wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint:webext": "web-ext lint --source-dir .output/firefox-mv3",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "WXT_E2E=1 wxt build && WXT_E2E=1 wxt build -b firefox",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:live": "WDIO_LIVE=1 wdio run wdio.conf.ts"
  },
  "dependencies": {
    "@bpmn-io-browser-plugin/core": "*",
    "bpmn-js": "18.26.0",
    "dmn-js": "17.10.2",
    "webext-permission-toggle": "7.1.1"
  },
  "devDependencies": {
    "@wdio/cli": "9.31.5",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/types": "9.31.2",
    "expect-webdriverio": "6.0.9",
    "happy-dom": "20.11.15",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "web-ext": "10.6.0",
    "webdriverio": "9.31.5",
    "wxt": "0.21.4"
  }
}
