{
  "name": "@git-diagram-viewer/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free BPMN parsing & semantic diff core (no DOM, no bpmn-js viewer).",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "bpmn-moddle": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "dependency-cruiser": "18.1.1",
    "vitest": "4.1.10"
  }
}
