{
  "$schema": "https://unpkg.com/knip@6/schema.json"

  // Knip finds unused files, dependencies and exports across the workspaces.
  // It runs zero-config here: the workspaces come from package.json, and the
  // entry points are discovered by Knip's framework plugins from the existing
  // config — WXT (extension entrypoints + manifest), vitest (unit tests),
  // playwright (e2e specs), eslint/prettier/typescript — plus the `bin` field
  // that exposes the bot's CLI and the `main`/`exports` of the core library.
  // Add `entry`/`project` overrides here only if that auto-detection ever
  // misses a file. Run `npm run knip:fix` to auto-remove what it reports.
}
